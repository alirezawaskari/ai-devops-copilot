# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=true

# --- API auth ---
# Comma-separated list of accepted API keys for local/dev use.
API_KEYS=local-dev-key

# --- Database ---
DATABASE_URL=postgresql+asyncpg://copilot:copilot@postgres:5432/copilot

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Rate limiting ---
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- GitHub ---
# Personal access token with read-only repo scope. Only required for
# analyzing private repositories or creating pull requests.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# --- LLM (OpenAI-compatible) ---
LLM_API_KEY=sk-placeholder
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_ENABLED=true

# --- OpenTelemetry ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=ai-devops-copilot
